{"nodes": [{"id": "design_stitch_html_nosotros_desktop_mejorado_screen", "label": "Nosotros Desktop Screen (Mejorado)", "file_type": "document", "source_file": "design/stitch/html/nosotros-desktop-mejorado.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The 'mejorado' revision adds the tabbed Sobre Nosotros / Misi\u00f3n / Visi\u00f3n section and a responsive nav that the mobile variant lacks."}, {"id": "design_stitch_html_nosotros_desktop_mejorado_top_nav_bar", "label": "Flat Collapsible Top Nav", "file_type": "concept", "source_file": "design/stitch/html/nosotros-desktop-mejorado.html", "source_location": "header 'flat no shadows', #mobile-menu-btn / #mobile-nav", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A different navbar treatment from the catalog header: borderline-only (the literal 'flat no shadows' class string is a Stitch annotation, not real Tailwind), and it collapses into a vertical chevron list on mobile instead of handing off to a bottom nav."}, {"id": "design_stitch_html_nosotros_desktop_mejorado_historia_hero", "label": "Nuestra Historia Hero", "file_type": "concept", "source_file": "design/stitch/html/nosotros-desktop-mejorado.html", "source_location": "h1 display-lg 'Nuestra Historia' + full-width rounded-xl warehouse image", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Text-first hero: centered display-lg headline and body-lg subhead over a separate contained image, unlike the catalog hero where type sits on the photo."}, {"id": "design_stitch_html_nosotros_desktop_mejorado_values_bento_grid", "label": "Values Bento Grid", "file_type": "concept", "source_file": "design/stitch/html/nosotros-desktop-mejorado.html", "source_location": "md:grid-cols-3, Calidad OEM / Log\u00edstica Eficiente / Soporte T\u00e9cnico", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three rounded-xl cards, each led by a Material glyph (precision_manufacturing, local_shipping, verified) chipped on a primary-container tile - the icon-in-container treatment is the reusable value-card pattern."}, {"id": "design_stitch_html_nosotros_desktop_mejorado_tabs_navigation", "label": "Underline Tabs (Sobre Nosotros / Misi\u00f3n / Visi\u00f3n)", "file_type": "concept", "source_file": "design/stitch/html/nosotros-desktop-mejorado.html", "source_location": ".tab-button, data-target, active = text-primary + border-b-2 + bg-surface-container-low", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same active-state vocabulary as the top nav (primary text + 2px primary underline), so tabs and navigation share one selection language."}, {"id": "design_stitch_html_nosotros_desktop_mejorado_tab_content_panels", "label": "Alternating Two-Column Tab Panels", "file_type": "concept", "source_file": "design/stitch/html/nosotros-desktop-mejorado.html", "source_location": "#sobre-nosotros / #mision / #vision, .tab-content opacity fade 0.3s", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each panel is a text card plus a background-image card, with the image alternating left/right between panels to create rhythm across tab switches; hidden panels use display:none + opacity 0 with a 0.3s fade."}, {"id": "design_stitch_html_nosotros_desktop_mejorado_tab_switching_script", "label": "Tab Switching Script", "file_type": "code", "source_file": "design/stitch/html/nosotros-desktop-mejorado.html", "source_location": "DOMContentLoaded handler toggling .active and active-tab classes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Class-list manipulation only, no ARIA roles or aria-selected - an accessibility gap if the pattern is ported to production."}, {"id": "design_stitch_html_nosotros_desktop_mejorado_footer", "label": "Nosotros Four-Column Footer", "file_type": "concept", "source_file": "design/stitch/html/nosotros-desktop-mejorado.html", "source_location": "footer grid md:grid-cols-4, uppercase monospace column headings", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Diverges from the catalog footer: navigation is split across two columns (one with an invisible spacer heading), there is no contact column, and links are set in body-md rather than the technical face."}], "edges": [{"source": "design_stitch_html_nosotros_desktop_mejorado_screen", "target": "design_stitch_html_home_catalogo_desktop_design_token_system", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/nosotros-desktop-mejorado.html", "source_location": "identical tailwind.config token block", "weight": 1.0}, {"source": "design_stitch_html_nosotros_desktop_mejorado_screen", "target": "design_stitch_html_home_catalogo_desktop_material_symbols_icon_family", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/nosotros-desktop-mejorado.html", "source_location": null, "weight": 1.0}, {"source": "design_stitch_html_nosotros_desktop_mejorado_screen", "target": "design_stitch_html_nosotros_desktop_mejorado_top_nav_bar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/nosotros-desktop-mejorado.html", "source_location": "<!-- TopNavBar -->", "weight": 1.0}, {"source": "design_stitch_html_nosotros_desktop_mejorado_screen", "target": "design_stitch_html_nosotros_desktop_mejorado_historia_hero", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/nosotros-desktop-mejorado.html", "source_location": "<!-- Hero Section -->", "weight": 1.0}, {"source": "design_stitch_html_nosotros_desktop_mejorado_screen", "target": "design_stitch_html_nosotros_d