{"nodes": [{"id": "design_stitch_screenshots_home_catalogo_mobile_screenshot", "label": "Home/Catalogo Mobile Mockup (Stitch)", "file_type": "image", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Google Stitch generated mockup defining the mobile home/catalog screen for the AutopartesRG auto-parts catalog: a single scrolling column from app bar -> search -> vehicle/filter controls -> filter chips -> 2-up product grid -> footer, with a persistent bottom tab bar and floating WhatsApp button."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_top_app_bar", "label": "Top App Bar (hamburger + AutopartesRG wordmark + cart)", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Classic three-zone mobile header: menu left, centered brand wordmark for identity, cart right within thumb reach of the dominant hand."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_hamburger_menu", "label": "Hamburger Menu Trigger", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_mobile_cart_icon", "label": "Cart Icon", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_mobile_oem_search_bar", "label": "OEM Search Bar (\"Buscar por numero OEM o palabra clave\")", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Search is the first element below the header and is full-width, signalling that part lookup by OEM number is the primary task; the placeholder teaches users that both OEM codes and plain keywords are accepted."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_vehicle_selector", "label": "Add Vehicle Control (\"Anadir Vehiculo\")", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placed side-by-side with Filtrar and above the grid so the user declares their car before browsing; declaring a vehicle is what powers the per-product compatibility badges."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_filter_button", "label": "Filter Button (\"Filtrar\")", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rendered as the filled/dark variant next to the outlined Anadir Vehiculo, giving it visual priority; on mobile filters collapse behind a button instead of a sidebar to preserve vertical space."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_active_filter_chips", "label": "Active Filter Chip Row (Frenos, Toyota Hilux 2020, + Motor)", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Horizontally scrollable dismissible chips make hidden filter state visible after the filter sheet closes, each with an x affordance for one-tap removal; the vehicle itself appears as a chip so fitment context is never invisible."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_product_grid", "label": "Two-Column Product Grid", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 2-up grid on a narrow viewport balances scan density against image legibility for parts that must be recognized visually (pads, filters, shocks, spark plugs)."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_product_card", "label": "Product Card (image, compatibility badge, title, OEM ref, price, CTA)", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed vertical slot order (white photo tile, name, small grey OEM reference, bold price, full-width action button) keeps cards scannable in a two-column rhythm even when titles wrap to two or three lines."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_compatibility_badge", "label": "Compatibility Badge (green check / amber warning / red x)", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A corner badge on every product thumbnail encodes fit against the selected vehicle in a three-state traffic-light system, so the highest-risk decision in auto parts (will it fit my car) is answered before the user opens the detail page."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_vehicle_fitment_system", "label": "Vehicle Fitment / Compatibility System", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cross-cutting product concept implied by the screen: a selected vehicle (Toyota Hilux 2020) drives badges, CTA state and the Mi Garaje tab, reducing wrong-part returns."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_add_to_cart_cta", "label": "Primary CTA \"Anadir\" (orange, full-card width)", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Add-to-cart directly from the grid removes a navigation step for repeat buyers who already know the part; orange fill is reserved for this single primary action per card."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_cta_state_variants", "label": "CTA State Variants (Anadir / Ver Detalles / No Compatible disabled)", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The card button changes with fitment: filled Anadir for a confirmed fit, outlined Ver Detalles when fit is uncertain and needs verification, greyed No Compatible to block purchase of a part that does not fit the saved vehicle rather than hiding the listing."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_price_display", "label": "Bold Price Display", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_mobile_bottom_nav", "label": "Bottom Tab Bar (Inicio, Catalogo, Mi Garaje, Cuenta)", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four fixed thumb-zone destinations give the web catalog an app-like shell; the Catalogo tab is shown selected with a filled pill highlight to anchor the user's location."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_catalogo_tab", "label": "Catalogo Tab (active state)", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_mobile_mi_garaje_tab", "label": "Mi Garaje Tab (saved vehicles)", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dedicated garage destination implies vehicles are persisted per user and reused across sessions instead of re-entered on each visit."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_whatsapp_fab", "label": "Floating WhatsApp Contact Button", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persistent green FAB above the tab bar offers a human fallback when a buyer cannot confirm the right part, matching the LatAm norm of closing auto-parts sales over WhatsApp."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_footer", "label": "Footer (brand, Contacto, Terminos y Condiciones, copyright)", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_mobile_mobile_first_layout", "label": "Mobile-First Single-Column Layout", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Everything stacks in one scroll column on a light neutral background with generous card padding; controls that would be a desktop sidebar collapse into the Filtrar button."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_orange_accent_palette", "label": "Orange-on-Neutral Accent Palette", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single warm orange accent over white cards and grey chrome keeps attention on product photography and marks the one primary action per card; semantic green/amber/red are reserved exclusively for fitment badges."}, {"id": "design_stitch_screenshots_home_catalogo_mobile_spanish_localization", "label": "Spanish-Language UI Copy", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All labels, product names and legal links are in Spanish, indicating a Spanish-speaking (likely Latin American) target market."}], "edges": [{"source": "design_stitch_screenshots_home_catalogo_mobile_screenshot", "target": "design_stitch_screenshots_home_catalogo_mobile_top_app_bar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "weight": 1.0}, {"source": "design_stitch_screenshots_home_catalogo_mobile_screenshot", "target": "design_stitch_screenshots_home_catalogo_mobile_oem_search_bar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/screenshots/home-catalogo-mobile.png", "source_location": null, "weight": 1.0}, {"source": "design_stitch_screenshots_home_catalogo_mobile_screenshot", "target": "design_stitch_screenshots_home_catalogo_mobile_vehicle_selector", "relation": "references", "confidenc