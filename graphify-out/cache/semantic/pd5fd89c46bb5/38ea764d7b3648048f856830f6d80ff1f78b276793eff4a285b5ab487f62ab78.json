ros de B\u00fasqueda' / 'Refina tu selecci\u00f3n' over the same facet set", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_mobile_compact_product_card", "target": "design_stitch_html_home_catalogo_desktop_product_card", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "design/stitch/html/home-catalogo-mobile.html", "source_location": "same media / title / OEM / compatibility / price / action model at reduced density", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_mobile_horizontal_filter_chip_rail", "target": "design_stitch_html_home_catalogo_desktop_active_filter_chips", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "design/stitch/html/home-catalogo-mobile.html", "source_location": "rounded-full primary-container chips restating applied filters", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_mobile_bottom_navigation_bar", "target": "design_stitch_html_nosotros_mobile_collapsible_nav", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "design/stitch/html/home-catalogo-mobile.html", "source_location": "two incompatible mobile primary-navigation models across screens", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_mobile_whatsapp_fab", "target": "design_stitch_html_home_catalogo_desktop_whatsapp_brand_green_token", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-mobile.html", "source_location": "bg-[#25D366]", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_mobile_whatsapp_fab", "target": "design_stitch_html_home_catalogo_desktop_floating_whatsapp_button", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "design/stitch/html/home-catalogo-mobile.html", "source_location": "same persistent WhatsApp channel affordance, different icon source and offset", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_mobile_compatibility_status_badge", "target": "design_stitch_html_detalle_de_producto_desktop_traffic_light_compatibility_concept", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "design/stitch/html/home-catalogo-mobile.html", "source_location": "check_circle / warning / cancel three-state glyph set", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_mobile_bottom_navigation_bar", "target": "design_stitch_html_home_catalogo_desktop_top_nav_bar", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "design/stitch/html/home-catalogo-mobile.html", "source_location": "primary destination switcher; mobile substitutes Mi Garaje for Nosotros/Contacto", "weight": 1.0}], "hyperedges": []}