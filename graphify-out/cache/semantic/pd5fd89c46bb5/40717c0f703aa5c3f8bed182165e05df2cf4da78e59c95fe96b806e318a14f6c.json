{"nodes": [{"id": "design_autopartesrg_sistema_de_diseno", "label": "Sistema de dise\u00f1o AutopartesRG", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replica el proyecto Stitch \u00abAutopartes ERG Digital Catalog\u00bb con los mismos nombres de token, para que el marcado de las maquetas se traduzca uno a uno."}, {"id": "design_paleta_material_3", "label": "Paleta Material 3 en tema claro", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se conservan los nombres de token de Stitch en lugar de renombrarlos, para traducir el marcado de las maquetas sin mapeo intermedio. Definida en src/app/globals.css."}, {"id": "design_zonas_de_color", "label": "Zonas de color: azul para acci\u00f3n, neutro para contenido", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El azul separa acci\u00f3n de contenido: las tarjetas viven sobre el lienzo neutro y todo lo que sirve para manipularlas se ti\u00f1e."}, {"id": "design_sitio_solo_tema_claro", "label": "El sitio se mantiene en claro de principio a fin", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se prob\u00f3 un footer en azul profundo y se descart\u00f3: el logotipo lleva sigla y eslogan en gris oscuro, as\u00ed que sobre fondo profundo exig\u00eda una placa blanca que lo recortaba de la composici\u00f3n. Stitch adem\u00e1s solo define tokens de tema claro."}, {"id": "design_contraste_aa_verificado", "label": "Contraste AA verificado", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cabecera del panel 11.6:1, texto de apoyo 6.6:1, contacto 14.2:1, enlaces 7.4:1; primary 12.9:1 sobre fondo claro."}, {"id": "design_etiquetas_sin_opacidad", "label": "Etiquetas de 10-11px sin opacidad", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atenuarlas las dejaba en 3.98:1 y 4.45:1, y el umbral de 3:1 solo vale para texto grande."}, {"id": "design_tipografia_hanken_jetbrains", "label": "Tipograf\u00eda Hanken Grotesk + JetBrains Mono", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cargadas con next/font/google, autohospedadas, display: swap y sin <link> a Google. JetBrains Mono cubre todo lo que Stitch marca como label-technical."}, {"id": "design_escala_tipografica_stitch", "label": "Escala tipogr\u00e1fica de Stitch como utilidades Tailwind", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_escala_espaciado_forma", "label": "Escala de espaciado, radios y elevaci\u00f3n", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Escala xs/sm/md/lg/xl de Stitch, contenedor max-w-7xl y elevaci\u00f3n en tres niveles."}, {"id": "design_material_symbols_subconjunto", "label": "Subconjunto de Material Symbols Outlined", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "La familia completa pesa varios megabytes; se autohospeda solo el subconjunto de glifos que usa el sitio. El tipo IconName hace que un glifo fuera del subconjunto no compile."}, {"id": "design_estructura_del_sitio", "label": "Estructura del sitio en siete bloques", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Barra superior fija, hero, cat\u00e1logo, ficha en di\u00e1logo, Nosotros en ruta aparte, footer y barra inferior m\u00f3vil."}, {"id": "design_tratamientos_display_tight_eyebrow", "label": "Tratamientos .display-tight y .eyebrow", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dan el registro t\u00e9cnico y sobrio sobre la escala de Stitch."}, {"id": "design_movimiento_solo_css", "label": "Movimiento en CSS puro, 0 KB de JavaScript", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin librer\u00eda de animaci\u00f3n: progreso de lectura y aparici\u00f3n de tarjetas se resuelven con animation-timeline, sin listeners de scroll."}, {"id": "design_prefers_reduced_motion", "label": "Todo el motion bajo prefers-reduced-motion", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Con movimiento reducido la interfaz queda est\u00e1tica y completa, no degradada."}, {"id": "design_trampa_tailwind_v4_transform", "label": "Trampa de Tailwind v4: translate/scale/rotate no son transform", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "En v4 esas utilidades emiten propiedades CSS independientes; una transici\u00f3n declarada sobre transform no las interpola. Hay que nombrarlas o usar transition-transform."}, {"id": "design_desviaciones_respecto_a_maquetas", "label": "Desviaciones deliberadas respecto a las maquetas", "file_type": "concept", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Registro expl\u00edcito de en qu\u00e9 se aparta la implementaci\u00f3n de Stitch y por qu\u00e9."}, {"id": "design_sin_precio_condicion_stock", "label": "Sin precio, condici\u00f3n ni disponibilidad", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin un sistema de inventario detr\u00e1s, publicarlos ser\u00eda prometer algo que no se puede sostener; se confirman por WhatsApp."}, {"id": "design_sin_carrito_ni_cuentas", "label": "Sin carrito ni sistema de cuentas", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El carrito est\u00e1 excluido del encargo; \u00abMi Garaje\u00bb y \u00abCuenta\u00bb depender\u00edan de un sistema de cuentas inexistente y quedar\u00edan como controles muertos."}, {"id": "design_sin_direccion_ni_horario", "label": "Sin direcci\u00f3n postal ni horario", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El comercio no tiene punto de venta f\u00edsico. Declarar una direcci\u00f3n falsa es motivo de acci\u00f3n manual por spam de datos estructurados."}, {"id": "design_sin_sku", "label": "Sin SKU: solo el n\u00famero OEM", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sin base de datos de inventario, un c\u00f3digo interno no identifica nada. El OEM s\u00ed es universal."}, {"id": "design_correcciones_de_contraste_cta", "label": "Correcciones de contraste en CTA y badges", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Blanco sobre el naranja del hero da 2.7:1 y no pasa AA; el texto oscuro da 5.9:1. Los badges de 10px se oscurecieron de 4.06:1 a 6.1-6.2:1."}, {"id": "design_tokens_ok_warn_unificados", "label": "Tokens ok/warn unificados", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Las maquetas se contradicen entre pantallas (#2e7d32 vs #10b981); un solo par de tokens mantiene la lectura constante."}], "edges": [{"source": "design_autopartesrg_sistema_de_diseno", "target": "design_paleta_material_3", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_autopartesrg_sistema_de_diseno", "target": "design_tipografia_hanken_jetbrains", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_autopartesrg_sistema_de_diseno", "target": "design_escala_espaciado_forma", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_autopartesrg_sistema_de_diseno", "target": "design_material_symbols_subconjunto", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": null, "weight": 1.0}, {"source": "design_autopartesrg_sistema_de_diseno", "target": "design_estructura_del_sitio", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "DESIGN.md", "source_location": null, "weight": 1.0}, {"sour