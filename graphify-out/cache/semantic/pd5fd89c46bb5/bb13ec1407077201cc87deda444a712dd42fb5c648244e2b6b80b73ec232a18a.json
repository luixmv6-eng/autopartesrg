{"nodes": [{"id": "design_stitch_html_detalle_de_producto_desktop_screen", "label": "Product Detail Desktop Screen", "file_type": "document", "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_html_detalle_de_producto_desktop_product_detail_modal", "label": "Product Detail Modal", "file_type": "concept", "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "main.max-w-container-max.max-h-[972px].rounded-xl, header 'Ficha T\u00e9cnica de Autoparte'", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detail is a modal over the catalog rather than a separate page, so filter state and scroll position survive inspecting a part. Fixed header with a 'verified' glyph and uppercase monospace label, an internally scrolling body, and a close button that turns error-red on hover."}, {"id": "design_stitch_html_detalle_de_producto_desktop_modal_backdrop", "label": "Blurred Modal Backdrop", "file_type": "concept", "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "div.fixed.inset-0.z-40.bg-on-background/40.backdrop-blur-sm aria-hidden", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_html_detalle_de_producto_desktop_image_gallery_zoom_panel", "label": "Product Image Panel with Zoom Affordance", "file_type": "concept", "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "lg:col-span-7 panel, mix-blend-multiply, group-hover:scale-105, zoom_in hint", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mix-blend-multiply drops the white studio background of catalog photography onto the panel surface without per-image cutouts; a glass zoom_in chip advertises magnification and hover scales the part 5%."}, {"id": "design_stitch_html_detalle_de_producto_desktop_breadcrumb", "label": "Category Breadcrumb", "file_type": "concept", "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "El\u00e9ctrico > Alternadores, chevron_right separator", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_html_detalle_de_producto_desktop_compatibility_confirmation_panel", "label": "Compatibility Confirmation Panel", "file_type": "concept", "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "bg-primary-fixed panel, 'Alta Compatibilidad Confirmada'", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source comment reads 'Traffic Light concept translated to brand theme' - the confirmed state is rendered in primary-fixed blue rather than green so a positive fitment reads as brand assurance instead of generic success, and it names the exact vehicles and engine (Nissan Versa 2012-2019, March 2012-2020 1.6L L4)."}, {"id": "design_stitch_html_detalle_de_producto_desktop_traffic_light_compatibility_concept", "label": "Traffic-Light Compatibility Signaling", "file_type": "rationale", "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "'Compatibility Status (Traffic Light concept translated to brand theme)' comment", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The system's core UX bet: fitment risk is the buying decision, so every surface that shows a part - grid card, mobile card, detail panel - carries a green/amber/red compatibility state before price. Each screen re-encodes it differently (icon pill, boxed strip, filled panel) according to available space."}, {"id": "design_stitch_html_detalle_de_producto_desktop_technical_specs_table", "label": "Zebra-Striped Technical Specs Table", "file_type": "concept", "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "grid-cols-3 rows alternating surface-container-low / surface-container-lowest", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built from CSS grid rows rather than a table element; alternating container surfaces carry the row separation, and stock state is shown with an inline colored dot plus unit count ('En Stock (3 unidades)')."}, {"id": "design_stitch_html_detalle_de_producto_desktop_whatsapp_quote_cta", "label": "Cotizar por WhatsApp CTA (Desktop)", "file_type": "concept", "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "button.bg-on-tertiary-container, chat glyph, active:scale-[0.98]", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The single primary action on the detail view is a WhatsApp quote, not add-to-cart - it uses the amber tertiary ramp instead of WhatsApp green here, keeping the in-page CTA inside the brand palette while the floating channel button stays #25D366."}, {"id": "design_stitch_html_detalle_de_producto_desktop_whatsapp_message_preview", "label": "Pre-filled WhatsApp Message Preview", "file_type": "rationale", "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "dashed-border block, italic '\"Hola, estoy interesado en el repuesto... para el veh\u00edculo...\"'", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A dashed placeholder box shows the exact message that will be sent, interpolating part name and vehicle. Previewing the payload removes the uncertainty of leaving the site for a chat app and guarantees the seller receives structured fitment context on first contact."}, {"id": "design_stitch_html_detalle_de_producto_desktop_whatsapp_first_quoting_flow", "label": "WhatsApp-First Quoting Flow", "file_type": "rationale", "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "Cotizar por WhatsApp CTA + message preview; mirrored by 'Consultar precio' and the floating chat buttons", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Checkout is never mocked. Cart and account icons exist in the chrome, but every terminal action across the screens routes to WhatsApp: catalog 'Consultar precio', floating 'Asistencia T\u00e9cnica', detail 'Cotizar por WhatsApp', mobile fixed action bar. The site is a catalog plus lead generator, not a transactional storefront - consistent with quote-dependent auto-parts pricing."}, {"id": "design_stitch_html_detalle_de_producto_desktop_related_products_grid", "label": "Related Parts Grid (Repuestos Relacionados)", "file_type": "concept", "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "account_tree heading + md:grid-cols-4 mini-cards", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reduced card: OEM/SKU line, 2-line title, price and a chevron that slides on hover. The account_tree glyph frames related parts as a system tree (alternator -> tensioner, starter, battery, ground strap) rather than merchandising cross-sell."}], "edges": [{"source": "design_stitch_html_detalle_de_producto_desktop_screen", "target": "design_stitch_html_home_catalogo_desktop_design_token_system", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "identical tailwind.config token block", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_desktop_screen", "target": "design_stitch_html_detalle_de_producto_desktop_product_detail_modal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "<!-- Modal Container -->", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_desktop_product_detail_modal", "target": "design_stitch_html_detalle_de_producto_desktop_modal_backdrop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": null, "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_desktop_product_detail_modal", "target": "design_stitch_html_detalle_de_producto_desktop_image_gallery_zoom_panel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "<!-- Left: Image Gallery (Span 7) -->", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_desktop_product_detail_modal", "target": "design_stitch_html_detalle_de_producto_desktop_breadcrumb", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "<!-- Breadcrumb / Category -->", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_desktop_product_detail_modal", "target": "design_stitch_html_detalle_de_producto_desktop_compatibility_confirmation_panel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": null, "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_desktop_product_detail_modal", "target": "design_stitch_html_detalle_de_producto_desktop_technical_specs_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "<!-- Technical Specs Table (Zebra Striping) -->", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_desktop_product_detail_modal", "target": "design_stitch_html_detalle_de_producto_desktop_related_products_grid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "<!-- Related Products Section -->", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_desktop_traffic_light_compatibility_concept", "target": "design_stitch_html_detalle_de_producto_desktop_compatibility_confirmation_panel", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "'Traffic Light concept translated to brand theme' comment", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_desktop_compatibility_confirmation_panel", "target": "design_stitch_html_home_catalogo_desktop_primary_color_token", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "bg-primary-fixed border-primary-fixed-dim text-on-primary-fixed", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_desktop_whatsapp_message_preview", "target": "design_stitch_html_detalle_de_producto_desktop_whatsapp_quote_cta", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "preview block directly under the CTA", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_desktop_whatsapp_first_quoting_flow", "target": "design_stitch_html_detalle_de_producto_desktop_whatsapp_quote_cta", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": null, "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_desktop_whatsapp_first_quoting_flow", "target": "design_stitch_html_home_catalogo_desktop_quote_on_request_card_variant", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "'Consultar precio' with forum glyph is the catalog-level entry to the same quoting flow", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_desktop_whatsapp_quote_cta", "target": "design_stitch_html_home_catalogo_desktop_tertiary_accent_color_token", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "bg-on-tertiary-container hover:bg-tertiary-fixed-dim text-on-tertiary-fixed", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_desktop_technical_specs_table", "target": "design_stitch_html_home_catalogo_desktop_jetbrains_mono_typeface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "font-label-technical on the whole table", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_desktop_related_products_grid", "target": "design_stitch_html_home_catalogo_desktop_product_card", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "design/stitch/html/detalle-de-producto-desktop.html", "source_location": "reduced card reusing the OEM / title / price content model without compatibility or CTA", "weight": 1.0}], "hyperedges": [{"id": "whatsapp_quoting_conversion_path", "label": "WhatsApp Quoting Conversion Path", "nodes": ["design_stitch_html_detalle_de_producto_desktop_whatsapp_first_quoting_flow", "design_stitch_html_home_catalogo_desktop_quote_on_request_card_variant", "design_stitch_html_home_catalogo_desktop_floating_whatsapp_button", "design_stitch_html_home_catalogo_mobile_whatsapp_fab", "design_stitch_html_detalle_de_producto_desktop_whatsapp_quote_cta", "design_stitch_html_detalle_de_producto_desktop_whatsapp_message_preview", "design_stitch_html_detalle_de_producto_mobile_fixed_bottom_action_bar"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.9, "source_file": "design/stitch/html/detalle-de-producto-desktop.html"}]}