{"nodes": [{"id": "design_stitch_html_home_catalogo_desktop_design_token_system", "label": "AutopartesRG Design Token System", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "script#tailwind-config", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single Material-3-style token set (colors, radius, spacing, fontFamily, fontSize) is duplicated verbatim inside every Stitch HTML export so each mockup renders standalone from a CDN Tailwind build with no shared stylesheet; the duplication is an export artifact, not an intentional per-screen theme."}, {"id": "design_stitch_html_home_catalogo_desktop_tailwind_config_block", "label": "Inline Tailwind Config Theme Extension", "file_type": "code", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "script#tailwind-config, darkMode: \"class\"", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "darkMode is set to 'class' in every file but no dark palette is ever defined, so the token set is light-mode-only in practice; dark mode is scaffolded but unimplemented."}, {"id": "design_stitch_html_home_catalogo_desktop_color_token_palette", "label": "Material 3 Color Role Palette", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "tailwind.config.theme.extend.colors", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses Material 3 role naming (surface-container-lowest/low/high/highest, on-surface-variant, outline-variant, inverse-surface, *-fixed / *-fixed-dim) rather than raw hue names, so component classes express semantic elevation instead of literal colors."}, {"id": "design_stitch_html_home_catalogo_desktop_primary_color_token", "label": "Primary Corporate Blue Token (#00357f)", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "colors.primary #00357f / primary-container #004aad / primary-fixed #d9e2ff", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deep corporate blue anchors the 'technical reliability' brand read used across nav, prices, active states and filter chips."}, {"id": "design_stitch_html_home_catalogo_desktop_tertiary_accent_color_token", "label": "Tertiary Amber Accent Token", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "colors.tertiary-container #744400 / on-tertiary-container #ffb159 / tertiary-fixed-dim #ffb86b", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Amber/orange tertiary ramp is reserved for commercial call-to-action surfaces (add-to-cart, quote CTA), keeping blue for navigation and amber for transaction."}, {"id": "design_stitch_html_home_catalogo_desktop_semantic_status_colors", "label": "Ad-hoc Semantic Status Colors", "file_type": "rationale", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "#e8f5e9/#2e7d32 Nuevo badge, #fff3e0/#e65100 Remanufacturado badge, #fbc02d warning", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compatibility and condition signals (green ok / amber verify / red incompatible) are hard-coded hex literals outside the token system - green #2e7d32 or #10b981, amber #fbc02d or #f59e0b, red #ba1a1a - so the same semantic meaning has different values per screen. A gap the design system should close."}, {"id": "design_stitch_html_home_catalogo_desktop_whatsapp_brand_green_token", "label": "WhatsApp Brand Green (#25D366)", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "Floating WhatsApp Button, bg-[#25D366]", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberately kept outside the Material token set so the channel affordance reads as WhatsApp rather than as a brand-colored button."}, {"id": "design_stitch_html_home_catalogo_desktop_type_scale", "label": "Type Scale (display-lg to label-sm)", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "tailwind.config.theme.extend.fontSize", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eight steps: display-lg 48/56 -0.02em 700, headline-lg 32/40 600, headline-lg-mobile 24/32 600, headline-md 20/28 600, body-lg 18/28 400, body-md 16/24 400, label-technical 14/20 +0.02em 500, label-sm 12/16 500. headline-lg-mobile exists as an explicit mobile substitute for headline-lg / display-lg."}, {"id": "design_stitch_html_home_catalogo_desktop_hanken_grotesk_typeface", "label": "Hanken Grotesk Display/Body Typeface", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "Google Fonts link + fontFamily for display-lg, headline-*, body-*, label-sm", "source_url": "https://fonts.googleapis.com/css2?family=Hanken+Grotesk", "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_html_home_catalogo_desktop_jetbrains_mono_typeface", "label": "JetBrains Mono Technical Label Typeface", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "fontFamily.label-technical: [\"JetBrains Mono\"]", "source_url": "https://fonts.googleapis.com/css2?family=JetBrains+Mono", "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_html_home_catalogo_desktop_technical_monospace_labeling", "label": "Monospace Technical Labeling Convention", "file_type": "rationale", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "font-label-technical used on OEM codes, nav links, filter labels, chips, prices context", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every machine-readable or catalog-lookup string (OEM number, SKU, phone, email, filter name, nav item) is set in JetBrains Mono at 14/20 with +0.02em tracking. The monospace face makes part numbers scannable digit-by-digit and signals 'engineering data' versus marketing copy set in Hanken Grotesk."}, {"id": "design_stitch_html_home_catalogo_desktop_spacing_scale", "label": "Spacing Scale (xs 4 / sm 8 / md 16 / lg 24 / xl 40)", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "tailwind.config.theme.extend.spacing", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named 4px-based ramp plus two layout constants: container-max 1280px (page shell width) and gutter 20px. The xl jump from 24 to 40 gives section-level breathing room without adding another step."}, {"id": "design_stitch_html_home_catalogo_desktop_border_radius_scale", "label": "Border Radius Scale (4 / 8 / 12 / full)", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "tailwind.config.theme.extend.borderRadius", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DEFAULT 0.25rem for controls, lg 0.5rem for cards, xl 0.75rem for panels/modals/sheets, full 9999px reserved for chips and FABs - radius encodes component altitude."}, {"id": "design_stitch_html_home_catalogo_desktop_material_symbols_icon_family", "label": "Material Symbols Outlined Icon Family", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "font-variation-settings 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24", "source_url": "https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined", "captured_at": null, "author": null, "contributor": null, "rationale": "Outlined at FILL 0 by default with a .fill / .filled modifier class switching FILL to 1 to mark active or emphasized state (active bottom-nav item, confirmed compatibility, brand mark). Domain glyphs recur across screens: build_circle, directions_car, category, settings_input_component, inventory_2, precision_manufacturing, local_shipping, verified, tune, check_circle, warning, cancel. WhatsApp has no Material glyph, so an inline brand SVG is used on mobile and 'chat' stands in on desktop."}, {"id": "design_stitch_html_home_catalogo_desktop_screen", "label": "Home / Cat\u00e1logo Desktop Screen", "file_type": "document", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_html_home_catalogo_desktop_top_nav_bar", "label": "Desktop Top Navigation Bar", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "header#mainHeader", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed 64px bar, container-max centered: brand lockup (build_circle + wordmark), four monospace links with an underlined active item, an inline rounded-full search field shown only at lg, plus cart / account / mobile-menu icon buttons."}, {"id": "design_stitch_html_home_catalogo_desktop_scroll_shadow_header_behavior", "label": "Scroll-Reactive Header Shadow", "file_type": "code", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "inline script, window scroll listener toggling shadow-sm/shadow-md at scrollY > 10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Elevation is raised only once the page has scrolled so the header separates from content without adding a permanent hard edge at rest."}, {"id": "design_stitch_html_home_catalogo_desktop_hero_search_section", "label": "Hero Section with Part Finder", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "section.h-[409px], 'Encuentra la pieza exacta'", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Photographic engine-macro background under a left-to-right surface/90 to surface/40 gradient scrim keeps display-lg text legible. The search bar pairs a free-text field with an optional VIN/chassis field, encoding the domain insight that exact fitment is identified by vehicle, not by keyword. Submit button uses a hard-coded #ff6f00 orange rather than a token."}, {"id": "design_stitch_html_home_catalogo_desktop_filter_sidebar", "label": "Filter Sidebar (SideNavBar)", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "aside.md:w-72, 'Filtros de B\u00fasqueda' / 'Refina tu selecci\u00f3n'", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sticky top-24 rounded-xl panel with its own header, scrolling accordion body (h-[calc(100vh-200px)]) and a pinned 'Limpiar Filtros' footer. Six collapsible facets - Marca, Categor\u00eda, Secci\u00f3n, Modelo/A\u00f1o, Condici\u00f3n, Disponibilidad - each with a leading Material glyph and a chevron that rotates 180deg on expand. The open facet is filled with primary-container."}, {"id": "design_stitch_html_home_catalogo_desktop_active_filter_chips", "label": "Active Filter Chip Row", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "'Filtros activos:' chip strip above the product grid", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "rounded-full dismissible chips restate sidebar state above the results so the applied query is readable without scanning the accordion; a right-aligned 'Ver 124 resultados' link closes the loop with a result count."}, {"id": "design_stitch_html_home_catalogo_desktop_product_card", "label": "Desktop Product Card", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "Product Card 1 / 2, bg-surface-container-lowest rounded-lg", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed slot order: h-48 contained product shot on surface-container-highest, absolute condition badge (Nuevo / Remanufacturado), 2-line clamped title, monospace OEM number, a boxed compatibility strip with a status glyph, then a bottom-anchored price + 'Ver detalle' outline button. Naming the OEM code and fitment before the price reflects a B2B/mechanic buying order rather than a consumer one."}, {"id": "design_stitch_html_home_catalogo_desktop_quote_on_request_card_variant", "label": "Quote-on-Request Card Variant", "file_type": "rationale", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "Product Card 3, 'Precio sujeto a cotizaci\u00f3n' + 'Consultar precio' button", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Some SKUs (remanufactured, multi-fitment) carry no fixed price, so the card swaps the price line for italic 'Precio sujeto a cotizaci\u00f3n' and the 'Ver detalle' button for a full-width neutral 'Consultar precio' with a forum glyph. It also spans two rows / two columns in the grid, using bento asymmetry to mark the higher-value item."}, {"id": "design_stitch_html_home_catalogo_desktop_product_grid", "label": "Bento Product Grid", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-lg", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "1/2/3 column responsive grid where selected cards claim extra row or column spans - a deliberate 'bento style hint' noted in the source comment - so the layout is not a uniform product matrix."}, {"id": "design_stitch_html_home_catalogo_desktop_floating_whatsapp_button", "label": "Floating WhatsApp Button (Desktop)", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "fixed bottom-8 right-8, bg-[#25D366], tooltip 'Asistencia T\u00e9cnica'", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persistent circular FAB with a hover-revealed inverse-surface tooltip; framed as 'Asistencia T\u00e9cnica' rather than sales chat, positioning WhatsApp as the fitment-advice channel."}, {"id": "design_stitch_html_home_catalogo_desktop_footer", "label": "Desktop Four-Column Footer", "file_type": "concept", "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "footer.bg-surface-container-high, 4-column grid + copyright bar", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brand blurb + social, Navegaci\u00f3n, Legal, and a 'Contacto T\u00e9cnico' column whose address, phone and email are set in the monospace technical face."}], "edges": [{"source": "design_stitch_html_home_catalogo_desktop_design_token_system", "target": "design_stitch_html_home_catalogo_desktop_tailwind_config_block", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "script#tailwind-config", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_design_token_system", "target": "design_stitch_html_home_catalogo_desktop_color_token_palette", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "theme.extend.colors", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_design_token_system", "target": "design_stitch_html_home_catalogo_desktop_type_scale", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "theme.extend.fontSize", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_design_token_system", "target": "design_stitch_html_home_catalogo_desktop_spacing_scale", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "theme.extend.spacing", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_design_token_system", "target": "design_stitch_html_home_catalogo_desktop_border_radius_scale", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "theme.extend.borderRadius", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_color_token_palette", "target": "design_stitch_html_home_catalogo_desktop_primary_color_token", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": null, "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_color_token_palette", "target": "design_stitch_html_home_catalogo_desktop_tertiary_accent_color_token", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": null, "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_semantic_status_colors", "target": "design_stitch_html_home_catalogo_desktop_color_token_palette", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "hard-coded status hexes sit outside theme.extend.colors", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_whatsapp_brand_green_token", "target": "design_stitch_html_home_catalogo_desktop_color_token_palette", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "bg-[#25D366] arbitrary value, not a token", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_type_scale", "target": "design_stitch_html_home_catalogo_desktop_hanken_grotesk_typeface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "theme.extend.fontFamily", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_type_scale", "target": "design_stitch_html_home_catalogo_desktop_jetbrains_mono_typeface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "fontFamily.label-technical", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_technical_monospace_labeling", "target": "design_stitch_html_home_catalogo_desktop_jetbrains_mono_typeface", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "font-label-technical usage on OEM/SKU strings", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_screen", "target": "design_stitch_html_home_catalogo_desktop_design_token_system", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": null, "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_screen", "target": "design_stitch_html_home_catalogo_desktop_material_symbols_icon_family", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "Material Symbols stylesheet + .material-symbols-outlined rule", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_screen", "target": "design_stitch_html_home_catalogo_desktop_top_nav_bar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "<!-- TopNavBar -->", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_screen", "target": "design_stitch_html_home_catalogo_desktop_hero_search_section", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "<!-- Hero Section -->", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_screen", "target": "design_stitch_html_home_catalogo_desktop_filter_sidebar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "<!-- SideNavBar (Filters) -->", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_screen", "target": "design_stitch_html_home_catalogo_desktop_product_grid", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "<!-- Product Grid (Bento style hint) -->", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_screen", "target": "design_stitch_html_home_catalogo_desktop_floating_whatsapp_button", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-catalogo-desktop.html", "source_location": "<!-- Floating WhatsApp Button -->", "weight": 1.0}, {"source": "design_stitch_html_home_catalogo_desktop_screen", "target": "design_stitch_html_home_catalogo_desktop_footer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/home-