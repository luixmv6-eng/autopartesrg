{"nodes": [{"id": "design_stitch_html_detalle_de_producto_mobile_screen", "label": "Product Detail Mobile Screen", "file_type": "document", "source_file": "design/stitch/html/detalle-de-producto-mobile.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The desktop modal becomes a full-page route on mobile: no backdrop, no close button, a back arrow instead - modal-over-catalog is not viable at phone width."}, {"id": "design_stitch_html_detalle_de_producto_mobile_back_header", "label": "Transactional Back Header", "file_type": "concept", "source_file": "design/stitch/html/detalle-de-producto-mobile.html", "source_location": "header h-16, comment 'Transactional Context - No full nav, just back'", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Source comment states the intent explicitly: on a transactional screen the nav is stripped to back / wordmark / search / cart so nothing competes with the purchase decision."}, {"id": "design_stitch_html_detalle_de_producto_mobile_swipeable_image_gallery", "label": "Swipeable Image Gallery with Dot Indicators", "file_type": "concept", "source_file": "design/stitch/html/detalle-de-producto-mobile.html", "source_location": "aspect-square snap-x snap-mandatory hide-scrollbar + 2 dot indicators", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CSS scroll-snap carousel with no JS; the desktop single-image zoom panel is replaced by horizontal paging because pinch-zoom is native on touch."}, {"id": "design_stitch_html_detalle_de_producto_mobile_technical_specs_table", "label": "Mobile Technical Specs Table", "file_type": "concept", "source_file": "design/stitch/html/detalle-de-producto-mobile.html", "source_location": "'Especificaciones T\u00e9cnicas', 50/50 flex rows, alternating surfaces", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Same zebra pattern as desktop but a 1:1 label/value split instead of 1:2, and both columns set in the monospace technical face."}, {"id": "design_stitch_html_detalle_de_producto_mobile_related_products_carousel", "label": "Related Parts Horizontal Carousel", "file_type": "concept", "source_file": "design/stitch/html/detalle-de-producto-mobile.html", "source_location": "overflow-x-auto snap-x hide-scrollbar, min-w-[160px] cards", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The desktop 4-up related grid becomes a snap carousel of fixed 160px cards, preserving the same OEM / title / price content model."}, {"id": "design_stitch_html_detalle_de_producto_mobile_fixed_bottom_action_bar", "label": "Fixed Bottom Action Bar", "file_type": "concept", "source_file": "design/stitch/html/detalle-de-producto-mobile.html", "source_location": "div.fixed.bottom-0 pb-safe, shadow-[0_-4px_12px], full-width green 'Cotizar por WhatsApp'", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces both the desktop CTA block and the floating FAB: the quote action is always on screen as a full-width bar with an upward shadow and pb-safe for the home indicator. Uses green-600 utility rather than the amber tertiary token used on desktop - an inconsistency in how the same CTA is themed."}], "edges": [{"source": "design_stitch_html_detalle_de_producto_mobile_screen", "target": "design_stitch_html_home_catalogo_desktop_design_token_system", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-mobile.html", "source_location": "identical tailwind.config token block", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_mobile_screen", "target": "design_stitch_html_detalle_de_producto_mobile_back_header", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-mobile.html", "source_location": null, "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_mobile_screen", "target": "design_stitch_html_detalle_de_producto_mobile_swipeable_image_gallery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-mobile.html", "source_location": "<!-- Image Gallery Area -->", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_mobile_screen", "target": "design_stitch_html_detalle_de_producto_mobile_technical_specs_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-mobile.html", "source_location": "<!-- Technical Specs -->", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_mobile_screen", "target": "design_stitch_html_detalle_de_producto_mobile_related_products_carousel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-mobile.html", "source_location": "<!-- Related Products -->", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_mobile_screen", "target": "design_stitch_html_detalle_de_producto_mobile_fixed_bottom_action_bar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/html/detalle-de-producto-mobile.html", "source_location": "<!-- Fixed Bottom Action Bar -->", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_mobile_screen", "target": "design_stitch_html_detalle_de_producto_desktop_product_detail_modal", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "design/stitch/html/detalle-de-producto-mobile.html", "source_location": "same detail content model rendered as a full page instead of a modal", "weight": 1.0}, {"source": "design_stitch_html_detalle_de_producto_mo