{"nodes": [{"id": "design_stitch_screenshots_nosotros_mobile_screen", "label": "Nosotros Mobile Screen (Stitch Mockup)", "file_type": "image", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_nosotros_mobile_autopartesrg_brand", "label": "AutopartesRG Brand Identity", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_nosotros_mobile_single_column_layout", "label": "Single-Column Mobile Layout", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Narrow mobile viewport: hero text, photo, value cards and footer are stacked vertically full-width so the page reads as one continuous scroll with no horizontal panning."}, {"id": "design_stitch_screenshots_nosotros_mobile_mobile_header", "label": "Mobile Header Bar", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compact top bar keeps the AutopartesRG wordmark on the left and shopping-cart plus hamburger icons on the right, reserving scarce mobile width for content while keeping commerce and navigation always reachable."}, {"id": "design_stitch_screenshots_nosotros_mobile_hamburger_menu", "label": "Hamburger Menu Trigger", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full navigation collapses behind an icon on mobile because the catalog nav items do not fit horizontally at this width."}, {"id": "design_stitch_screenshots_nosotros_mobile_cart_icon", "label": "Shopping Cart Icon", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_nosotros_mobile_nuestra_historia_hero", "label": "Nuestra Historia Hero Section", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opens the About page with a bold headline plus a short trust-oriented paragraph about confidence and mechanical precision in every part, framing the company story before any proof points."}, {"id": "design_stitch_screenshots_nosotros_mobile_warehouse_technician_photo", "label": "Warehouse Technician Photo", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A rounded-corner photo of a uniformed staff member inspecting a part in a stocked parts aisle gives visual evidence of real inventory and expertise, supporting the credibility claim made in the hero copy."}, {"id": "design_stitch_screenshots_nosotros_mobile_value_cards", "label": "Stacked Value Proposition Cards", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three differentiators are broken into separate bordered cards, each with a blue icon tile, a short bold title and two lines of supporting copy, so the value proposition scans quickly on a small screen instead of reading as a paragraph."}, {"id": "design_stitch_screenshots_nosotros_mobile_blue_icon_tile", "label": "Blue Square Icon Tile", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A saturated blue rounded square is the only strong color on an otherwise neutral white/grey page, acting as the brand accent and as an anchor point for the eye when scanning the card stack."}, {"id": "design_stitch_screenshots_nosotros_mobile_calidad_oem", "label": "Calidad OEM Value", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_nosotros_mobile_logistica_eficiente", "label": "Logistica Eficiente Value", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_nosotros_mobile_soporte_tecnico", "label": "Soporte Tecnico Value", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_nosotros_mobile_footer", "label": "Site Footer", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Footer sits on a tinted grey band that separates it from page content, repeating the wordmark and a 2024 copyright line before the stacked link groups."}, {"id": "design_stitch_screenshots_nosotros_mobile_navegacion_links", "label": "NAVEGACION Footer Link Group", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Inicio, Catalogo and Nosotros are repeated in the footer as a vertical list, giving a second navigation path at the end of a long scroll where the header is out of view."}, {"id": "design_stitch_screenshots_nosotros_mobile_legal_links", "label": "LEGAL Footer Link Group", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_nosotros_mobile_spanish_localization", "label": "Spanish-Language UI Copy", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_nosotros_mobile_trust_building_about_page", "label": "Trust-Building About Page Pattern", "file_type": "concept", "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The screen's job is credibility, not conversion: story copy, then a real-operations photo, then three proof-point cards, with no product listing or call-to-action button anywhere on the page."}], "edges": [{"source": "design_stitch_screenshots_nosotros_mobile_screen", "target": "design_stitch_screenshots_nosotros_mobile_mobile_header", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "weight": 1.0}, {"source": "design_stitch_screenshots_nosotros_mobile_screen", "target": "design_stitch_screenshots_nosotros_mobile_nuestra_historia_hero", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design/stitch/screenshots/nosotros-mobile.png", "source_location": null, "weight