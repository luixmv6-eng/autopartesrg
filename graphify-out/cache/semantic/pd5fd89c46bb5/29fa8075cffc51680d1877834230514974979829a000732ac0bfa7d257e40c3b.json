{"nodes": [{"id": "design_stitch_screenshots_home_catalogo_desktop_screen", "label": "Home/Catalogo Desktop Screen (Stitch Mockup)", "file_type": "image", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_desktop_brand_autopartesrg", "label": "AutopartesRG Brand Identity", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_desktop_header_nav", "label": "Sticky Header Navigation (Inicio, Catalogo, Nosotros, Contacto)", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four-item flat nav plus persistent global search, cart and account icons keeps the catalog reachable from any page without a mega-menu."}, {"id": "design_stitch_screenshots_home_catalogo_desktop_global_search_bar", "label": "Global Header Search Bar", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_desktop_hero_section", "label": "Hero Section 'Encuentra la pieza exacta'", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full-bleed dark-overlaid photo collage of engine/parts imagery with centered headline and sub-copy sets an industrial, technical tone and frames the primary task (find the exact part) above the fold."}, {"id": "design_stitch_screenshots_home_catalogo_desktop_vin_plate_lookup", "label": "VIN / Placa Vehicle Lookup Field", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Offering VIN/plate entry alongside free-text part search lets buyers who do not know part numbers resolve fitment from their vehicle identity instead."}, {"id": "design_stitch_screenshots_home_catalogo_desktop_hero_search_form", "label": "Hero Dual-Input Search Form with Buscar CTA", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_desktop_filter_sidebar", "label": "Filter Sidebar 'Filtros de Busqueda'", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persistent left rail with collapsible accordion groups (Marca, Categoria, Vehiculo, Modelo/Ano, Condicion, Disponibilidad) exposes the full facet taxonomy on desktop where horizontal space is cheap; only the active group is expanded to limit visual load."}, {"id": "design_stitch_screenshots_home_catalogo_desktop_faceted_search", "label": "Faceted Catalog Search Pattern", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_desktop_facet_taxonomy", "label": "Facet Taxonomy (Marca, Categoria, Vehiculo, Modelo/Ano, Condicion, Disponibilidad)", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_desktop_clear_filters_action", "label": "Limpiar Filtros Action", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_desktop_active_filter_chips", "label": "Active Filter Chips Row ('Filtros activos')", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dismissible chips above the grid mirror the sidebar state so the user can see and undo each applied constraint without scanning the rail."}, {"id": "design_stitch_screenshots_home_catalogo_desktop_results_counter", "label": "Results Counter ('Ver 124 resultados')", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_desktop_product_grid", "label": "Three-Column Product Result Grid", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three cards per row beside the fixed sidebar balances part-photo legibility against result density on a desktop viewport."}, {"id": "design_stitch_screenshots_home_catalogo_desktop_product_card", "label": "Product Card (photo, name, SKU/REF, badge, price, Ver detalle)", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_desktop_condition_badge", "label": "Condition Badge (NUEVO / REMANUFACTURADO)", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Color-coded corner badge (green for nuevo, orange for remanufacturado) makes part condition scannable at grid level, since condition drives price and buyer trust in auto parts."}, {"id": "design_stitch_screenshots_home_catalogo_desktop_compatibility_badge", "label": "Vehicle Compatibility Badge on Card", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Surfacing a 'Compatible' line (e.g. Toyota Corolla 2019-2023 / Multiple models) directly on the card answers the dominant fitment question before the user opens the detail page."}, {"id": "design_stitch_screenshots_home_catalogo_desktop_quote_pricing", "label": "Quote-on-Request Pricing ('Precio previa cotizacion' / 'Consultar precio')", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High-value or variable-cost parts replace the price and 'Ver detalle' button with a quote CTA, letting the catalog list items whose price cannot be published."}, {"id": "design_stitch_screenshots_home_catalogo_desktop_whatsapp_fab", "label": "Floating WhatsApp Contact Button", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A persistent green FAB pinned to the lower-right offers an instant human sales/advisory channel, matching Latin American B2C buying habits for parts fitment questions."}, {"id": "design_stitch_screenshots_home_catalogo_desktop_footer", "label": "Site Footer (Navegacion, Legal, Contacto Tecnico)", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_desktop_spanish_localization", "label": "Spanish-Language UI Copy", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_desktop_ecommerce_cart", "label": "Shopping Cart / Account Icons", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_stitch_screenshots_home_catalogo_desktop_dark_industrial_theme", "label": "Dark Industrial Visual Theme with Blue Accent", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark navy header/hero/footer bookend a light content area, and a single saturated blue is reserved for primary actions (Buscar, active facet, Ver detalle) so CTAs stay unambiguous."}, {"id": "design_stitch_screenshots_home_catalogo_desktop_merged_home_catalog", "label": "Merged Home + Catalog Single-Page Layout", "file_type": "concept", "source_file": "design/stitch/screenshots/home-catalogo-desktop.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The landing hero and the filtered catalog live on one scroll, so a visitor goes from arrival to browsable results wi