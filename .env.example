# Número de WhatsApp de destino. OPCIONAL: el real vive en src/lib/contacto.ts,
# porque es un dato público del negocio y así no puede faltar al desplegar.
# Rellénalo solo para desviar las pruebas a otro número.
# Formato: solo dígitos con código de país. Colombia: 57 + celular de 10 dígitos.
# NEXT_PUBLIC_WHATSAPP_NUMBER=573001234567

# URL pública del sitio. Se usa en metadatos, Open Graph, sitemap.xml y robots.txt.
#
# Sin barra final, sin `www` y en https: es la forma canónica del dominio.
# En desarrollo se pone http://localhost:3000 en .env.local; si se deja vacía,
# el sitio cae al dominio real definido en src/lib/contacto.ts.
NEXT_PUBLIC_SITE_URL=https://autopartesergsas.com

# ─────────────────────────────────────────────────────────────────────
# Panel de administración (/admin)
#
# Las dos primeras son SECRETAS: sin el prefijo NEXT_PUBLIC_, para que Next NO
# las incruste en el JavaScript que descarga el navegador. Se configuran en el
# panel del hosting, nunca en el repositorio.
#
# Se generan con:  npm run admin:clave
# ─────────────────────────────────────────────────────────────────────

# Resumen scrypt de la contraseña del panel. La contraseña en claro no se guarda.
ADMIN_PASSWORD_HASH=scrypt.16384........

# Clave con la que se firman las cookies de sesión. Mínimo 32 caracteres.
# Cambiarla cierra al instante todas las sesiones abiertas.
ADMIN_SESSION_SECRET=

# Carpeta donde viven el catálogo, las fotos y las copias de seguridad.
# Si se omite, se usa "datos/" junto al proyecto.
#
# En el servidor conviene apuntarla FUERA de la carpeta del sitio, para que
# actualizar el código no pueda tocar los datos de la empresa. Por ejemplo:
#   ADMIN_DATA_DIR=/home/usuario/datos-autopartes
ADMIN_DATA_DIR=
